package PACKAGE_test

import (
	"context"
	"fmt"
	"net"
	"net/url"
	"os"
	"path"
	"strconv"
	"strings"
	"testing"
	"time"

	"github.com/testcontainers/testcontainers-go/internal/core"
	sbx "github.com/testcontainers/testcontainers-go/modules/sbx"
)

// This provider only borrows the parent's proxy. It has no sandbox ownership,
// and importing sbx registers its default factory without initializing it.
type sbxInheritedProvider struct {
	config core.RuntimeConfig
}

func (p sbxInheritedProvider) Initialize(context.Context) (core.RuntimeConfig, error) {
	return p.config, nil
}

func registerSBXInheritance() error {
	const prefix = "TCGO_SBX_INHERITED_"
	keys := []string{"DOCKER_HOST", "SOCKET_PATH", "PUBLISHED_HOST", "BRIDGE"}
	// Use raw environment here so TestMain does not cache configuration before tests adjust it.
	present := os.Getenv("TESTCONTAINERS_PROVIDER") == "sbx-inherited"
	for _, key := range keys {
		if _, ok := os.LookupEnv(prefix + key); ok {
			present = true
		}
	}
	if !present {
		return nil
	}
	for _, key := range keys {
		if strings.TrimSpace(os.Getenv(prefix+key)) == "" {
			return fmt.Errorf("sbx inheritance requires nonempty %s%s", prefix, key)
		}
	}
	cfg := core.RuntimeConfig{
		Name:                 "sbx-inherited",
		DockerHost:           os.Getenv(prefix + "DOCKER_HOST"),
		DockerSocketPath:     os.Getenv(prefix + "SOCKET_PATH"),
		PublishedHost:        os.Getenv(prefix + "PUBLISHED_HOST"),
		DefaultBridgeNetwork: os.Getenv(prefix + "BRIDGE"),
	}
	endpoint, err := url.Parse(cfg.DockerHost)
	if err != nil || endpoint.Scheme != "tcp" || endpoint.User != nil || endpoint.Path != "" || endpoint.RawQuery != "" || endpoint.Fragment != "" {
		return fmt.Errorf("sbx inheritance: %sDOCKER_HOST must be a tcp://host:port endpoint", prefix)
	}
	host, port, err := net.SplitHostPort(endpoint.Host)
	portNumber, portErr := strconv.Atoi(port)
	if err != nil || host == "" || portErr != nil || portNumber < 1 || portNumber > 65535 {
		return fmt.Errorf("sbx inheritance: %sDOCKER_HOST must contain a host and valid port", prefix)
	}
	if !path.IsAbs(cfg.DockerSocketPath) || strings.ContainsAny(cfg.DockerSocketPath, "\x00\r\n") {
		return fmt.Errorf("sbx inheritance: %sSOCKET_PATH must be an absolute inner-daemon socket path", prefix)
	}
	if strings.ContainsAny(cfg.PublishedHost, " /\t\r\n") || strings.ContainsAny(cfg.DefaultBridgeNetwork, " \t\r\n") {
		return fmt.Errorf("sbx inheritance: malformed published host or bridge")
	}
	// Selection stays with each fixture: the autodetection child deliberately
	// uses legacy Docker discovery against DOCKER_HOST, and fake tests select
	// their own provider. Never select or initialize the default sbx here.
	if os.Getenv("TESTCONTAINERS_PROVIDER") == "sbx" {
		return fmt.Errorf("sbx inheritance: select sbx-inherited instead of the owning sbx provider")
	}
	return core.RegisterProvider("sbx-inherited", func() core.RuntimeProvider {
		return sbxInheritedProvider{config: cfg}
	})
}

func TestMain(m *testing.M) {
	code := 1
	if err := registerSBXInheritance(); err != nil {
		fmt.Fprintf(os.Stderr, "sbx test bootstrap: %v\n", err)
	} else if !core.HasRegisteredProvider("sbx") {
		fmt.Fprintln(os.Stderr, "sbx provider was not registered")
	} else {
		code = m.Run()
	}
	// Cleanup is safe when unused, including borrowed/fake/session processes.
	// A fresh context also permits cleanup after test or startup cancellation.
	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Minute)
	if err := sbx.Cleanup(ctx); err != nil {
		fmt.Fprintf(os.Stderr, "sbx cleanup: %v\n", err)
		code = 1
	}
	cancel()
	os.Exit(code)
}
